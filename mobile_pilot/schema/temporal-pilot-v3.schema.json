{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usercamera:temporal-pilot-v3",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_version",
    "participant_id",
    "session_id",
    "research_mode",
    "counterbalance_group",
    "trial_ids"
  ],
  "properties": {
    "schema_version": {
      "const": "temporal-pilot-v3"
    },
    "protocol_version": {
      "const": "mobile-pilot-rsm-v3"
    },
    "counterbalance_group": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "research_mode": {
      "enum": [
        "requested_only",
        "assigned_pre_task"
      ]
    },
    "trial_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "label_schema_version": {
      "const": "self-report-v3.1"
    }
  },
  "$defs": {
    "trial": {
      "type": "object",
      "required": [
        "protocol_version",
        "task_family",
        "stimulus",
        "research_mode",
        "assigned_assistance"
      ],
      "properties": {
        "task_family": {
          "enum": [
            "fixation",
            "readability",
            "visual_search",
            "mixed"
          ]
        }
      }
    },
    "assistance": {
      "type": "object",
      "required": [
        "type",
        "source",
        "research_mode",
        "assigned_assistance",
        "requested_action",
        "delivered_action"
      ],
      "properties": {
        "type": {
          "enum": [
            "assistance_requested",
            "intervention_onset",
            "intervention_end"
          ]
        },
        "source": {
          "enum": [
            "assigned_pre_task",
            "self_selected",
            "rescue_crossover"
          ]
        },
        "requested_action": {
          "type": [
            "null",
            "string"
          ]
        },
        "delivered_action": {
          "type": [
            "null",
            "string"
          ]
        },
        "oracle_target_highlight": {
          "type": "boolean"
        },
        "cue_candidate_count": {
          "type": [
            "null",
            "integer"
          ]
        }
      }
    },
    "feedback_v3_1": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "provided",
            "missing",
            "not_applicable"
          ]
        },
        "difficulty_rating": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "label_source": {
          "enum": [
            "self_report",
            "device_test_fixture"
          ]
        },
        "helpfulness_status": {
          "enum": [
            "provided",
            "unable_to_rate",
            "not_applicable_no_delivered_help"
          ]
        },
        "helpfulness_rating": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "provided"
              }
            }
          },
          "then": {
            "required": [
              "difficulty_rating",
              "label_source",
              "helpfulness_status",
              "helpfulness_rating",
              "label_schema_version"
            ]
          }
        },
        {
          "if": {
            "required": [
              "helpfulness_status"
            ],
            "properties": {
              "helpfulness_status": {
                "const": "provided"
              }
            }
          },
          "then": {
            "properties": {
              "helpfulness_rating": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              }
            }
          },
          "else": {
            "properties": {
              "helpfulness_rating": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}